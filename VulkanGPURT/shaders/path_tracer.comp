#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const float PI = 3.14159265359;
const uint MATERIAL_LAMBERTIAN = 0u;
const uint MATERIAL_METAL = 1u;
const uint MATERIAL_DIELECTRIC = 2u;

struct Sphere {
    vec4 centerRadius;
    vec4 albedoMaterialType;
    vec4 materialParams;
};

layout(std430, binding = 0) readonly buffer SceneBuffer {
    Sphere spheres[];
} sceneBuffer;

// Read-write: each dispatch accumulates its sample batch into the running total (see main()).
layout(std430, binding = 1) buffer OutputBuffer {
    vec4 pixels[];
} outputBuffer;

struct CameraData {
    vec4 lookFromDefocusAngle;
    vec4 lookAtFocusDist;
    vec4 viewUpVfov;
};

layout(std430, binding = 2) readonly buffer CameraBuffer {
    CameraData camera;
} cameraBuffer;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint sphereCount;
    uint samplesPerPixel;
    uint maxBounces;
    uint seed;
    uint sampleOffset;
} pc;

#include "path_tracer_lib.glsl"

void main() {
    // Get the pixel coordinates from the global invocation ID of the executing thread
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    // Calculate a unique seed for the random number generator based on the pixel index and a global seed.
    // Folding in sampleOffset gives each sample batch an independent RNG sequence, so batches don't repeat samples.
    uint index = pixel.y * pc.width + pixel.x;
    uint seed = index * 9781u + (pc.seed + pc.sampleOffset) * 6271u;

    vec3 sampleColor = vec3(0.0);   // Accumulate color samples for anti-aliasing and noise reduction

    for (uint s = 0u; s < pc.samplesPerPixel; ++s) {
        Ray ray = makeCameraRay(pixel, seed);               // Generate a ray from the camera through the pixel
        sampleColor += rayColor(ray, seed);         // Trace the ray through the scene and accumulate its color
    }

    // Accumulate this batch's summed radiance and its sample count into the running total. The render is
    // split across several dispatches to stay under the GPU watchdog timeout; the host divides the final
    // sum by the accumulated count (stored in .a) when tonemapping.
    outputBuffer.pixels[index] += vec4(sampleColor, float(pc.samplesPerPixel));
}
